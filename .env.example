# Copia este archivo como .env y llena los valores de tu proyecto Supabase.
# La "anon key" es pública por diseño: la seguridad real está en las políticas RLS.
# NUNCA pongas aquí la "service_role key": esa solo vive en el servidor.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
